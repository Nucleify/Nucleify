---
import '../styles/docs.css'
import 'highlight.js/styles/github-dark.min.css'
import DocsBrandMark from '../components/DocsBrandMark.astro'
import DocsSoftNav from '../components/DocsSoftNav.astro'
import { docsNavAriaLabel, docsOnThisPageLabel } from '../lib/constants/docs_ui'

interface Props {
  title: string
  lang: string
  category: string
  slug: string
}

const { title, lang, category, slug } = Astro.props
const pageTitle = `${title} · Nucleify Docs`
const navLabel = docsNavAriaLabel(lang)
const tocLabel = docsOnThisPageLabel(lang)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Nucleify documentation" />
    <title>{pageTitle}</title>
    <style is:inline>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #03050c;
        color: #e7ebe8;
      }
      html[data-soft-nav='loading'] .docs-shell,
      html[data-soft-nav='loading'] .docs-home__main {
        opacity: 0.72;
        transition: opacity 0.12s ease;
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;600&family=JetBrains+Mono:wght@600;700&display=optional"
      rel="stylesheet"
    />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/img/favicon.svg" />
  </head>
  <body class="docs-body">
    <DocsSoftNav />
    <header class="docs-header">
      <div class="docs-header__inner">
        <a class="docs-brand" href="/">
          <DocsBrandMark class="docs-brand__logo" width={32} height={32} idSuffix="header" />
          <span class="docs-brand__text">Nucleify Docs</span>
        </a>
        <slot name="header-extra" />
      </div>
    </header>
    <div class="docs-shell">
      <aside class="docs-sidebar" aria-label={navLabel}>
        <slot name="sidebar" />
      </aside>
      <main class="docs-main" id="docs-main">
        <article class="docs-article">
          <slot />
        </article>
      </main>
      <aside class="docs-toc-panel" aria-label={tocLabel}>
        <slot name="toc" />
      </aside>
    </div>
    <script>
      declare global {
        interface Window {
          __nucDocsLangSync?: boolean
        }
      }

      if (!window.__nucDocsLangSync) {
        window.__nucDocsLangSync = true
        const syncLang = () => {
          const lang = location.pathname.split('/').filter(Boolean)[0] || 'en'
          document.querySelectorAll('.docs-lang-switch a').forEach((link) => {
            const active = link.dataset.lang === lang
            if (active) link.setAttribute('aria-current', 'page')
            else link.removeAttribute('aria-current')
            link.classList.toggle('is-active', active)
          })
        }
        syncLang()
        document.addEventListener('astro:page-load', syncLang)
      }
    </script>
  </body>
</html>
