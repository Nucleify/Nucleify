---
/**
 * Brand mark as a static asset so MPA navigations reuse the cached image.
 */
interface Props {
  class?: string
  width?: number
  height?: number
  /** Kept for call-site compatibility (was used to uniquify inline SVG paint ids). */
  idSuffix?: string
}

const {
  class: className = 'docs-brand__logo',
  width = 32,
  height = 32,
} = Astro.props
---

<img
  class={className}
  src="/img/logo-transparent.webp"
  width={width}
  height={height}
  alt=""
  aria-hidden="true"
  decoding="async"
/>
