{
  "type": "module",
  "name": "data-manager",
  "description": "This website helps to storage various data types and share it with others.",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "open": "cypress open",
    "prepare": "husky install",
    "build": "vite build",
    "check": "npm run check:atomic && npm run check:modules && npm run check:cypress && npm run check:storybook && npm run check:vitest",
    "check:atomic": "prettier --check atomic",
    "check:cypress": "prettier --check cypress",
    "check:modules": "prettier --check modules",
    "check:storybook": "prettier --check .storybook/",
    "check:vitest": "prettier --check vitests",
    "lint": "npm run lint:atomic && npm run lint:modules && npm run lint:cypress && npm run lint:storybook && npm run lint:vitest",
    "lint:atomic": "eslint \"atomic/**/*.{js,ts,vue}\"",
    "lint:cypress": "eslint \"cypress/**/*.{ts,tsx}\"",
    "lint:modules": "eslint \"modules/**/*.{js,ts,vue}\"",
    "lint:storybook": "eslint \".storybook/**/*.{ts,tsx}\"",
    "lint:vitest": "eslint \"vitests/**/*.{ts,tsx}\"",
    "lint --fix": "npm run lint:atomic --fix && npm run lint:modules --fix && npm run lint:cypress --fix && npm run lint:storybook --fix && npm run lint:vitest --fix",
    "lint:atomic --fix": "eslint \"atomic/**/*.{js,ts,vue}\" --fix",
    "lint:cypress --fix": "eslint \"cypress/**/*.{ts,tsx}\" --fix",
    "lint:modules --fix": "eslint \"modules/**/*.{js,ts,vue}\" --fix",
    "lint:storybook --fix": "eslint \".storybook/**/*.{ts,tsx}\" --fix",
    "lint:vitest --fix": "eslint \"vitests/**/*.{ts,tsx}\" --fix",
    "slint": "npx stylelint \"atomic/bosons/styles/**/*.scss\"",
    "typeslint": "tsc --noemit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "write": "npm run write:atomic && npm run write:modules && npm run write:cypress && npm run write:storybook && npm run write:vitest",
    "write:atomic": "prettier --write atomic",
    "write:modules": "prettier --write modules",
    "write:cypress": "prettier --write cypress",
    "write:storybook": "prettier --write .storybook/",
    "write:vitest": "prettier --write vitests",
    "storybook": "storybook dev -p 6006 --ci",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@primevue/themes": "4.2.3",
    "chart.js": "4.4.3",
    "marked": "15.0.8",
    "primeflex": "3.3.1",
    "primeicons": "7.0.0",
    "primevue": "4.2.3",
    "quill": "2.0.3",
    "swiper": "11.1.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3.2.2",
    "@storybook/addon-essentials": "8.4.6",
    "@storybook/addon-interactions": "8.4.6",
    "@storybook/addon-onboarding": "8.4.6",
    "@storybook/blocks": "8.4.6",
    "@storybook/test": "8.4.6",
    "@storybook/vue3": "8.4.6",
    "@storybook/vue3-vite": "8.4.6",
    "@types/bootstrap": "5.2.10",
    "@types/marked": "5.0.2",
    "@types/node": "20.14.11",
    "@typescript-eslint/eslint-plugin": "7.3.1",
    "@typescript-eslint/parser": "7.0.2",
    "@vitejs/plugin-vue": "5.2.3",
    "@vitest/coverage-v8": "3.0.9",
    "axios": "1.8.4",
    "axios-mock-adapter": "2.0.0",
    "bootstrap": "5.2.3",
    "cypress": "13.11.0",
    "eslint": "8.57.0",
    "eslint-plugin-storybook": "0.8.0",
    "eslint-plugin-vue": "9.19.2",
    "husky": "8.0.3",
    "jsdom": "25.0.1",
    "laravel-vite-plugin": "1.2.0",
    "prettier": "3.3.3",
    "sass": "1.56.1",
    "storybook": "8.6.11",
    "stylelint": "16.10.0",
    "stylelint-config-standard": "36.0.1",
    "typescript": "5.3.3",
    "vite": "6.2.3",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-stylelint": "6.0.0",
    "vitest": "3.0.9",
    "vue": "3.4.30"
  }
}
