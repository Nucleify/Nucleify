    }
  },
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare:husky": "husky",
    "prepare:submodules": "sh .config/bash/prepare-submodules.sh",
    "check": "npx biome check .",
    "write": "npx biome check --write .",
    "slint": "npx stylelint \"**/**/*.scss\"",
    "slint:fix": "npx stylelint \"**/**/*.scss\" --fix",
    "tests": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "test:watch": "npx vitest",
    "typeslint": "tsc --noemit"
  },
