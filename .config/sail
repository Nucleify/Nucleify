#!/usr/bin/env sh

# Sail wrapper: injects config paths for pest and pint (configs live in .config/)

if [ "$1" = "pest" ]; then
  shift
  set -- pest -c .config/phpunit.xml "$@"
elif [ "$1" = "pint" ]; then
  shift
  set -- pint --config=.config/pint.json "$@"
fi

# Support bash to support `source` with fallback on $0 if this does not run with bash
selfArg="$BASH_SOURCE"
[ -z "$selfArg" ] && selfArg="$0"
self=$(realpath "$selfArg" 2>/dev/null || self="$selfArg")
dir=$(cd "${self%[/\\]*}" >/dev/null && cd '../laravel/sail/bin' && pwd)

if [ -d /proc/cygdrive ]; then
  case $(which php) in
    $(readlink -n /proc/cygdrive)/*)
      dir=$(cygpath -m "$dir")
      ;;
  esac
fi

export COMPOSER_RUNTIME_BIN_DIR="$(cd "${self%[/\\]*}" >/dev/null && pwd)"

bashSource="$BASH_SOURCE"
if [ -n "$bashSource" ] && [ "$bashSource" != "$0" ]; then
  source "${dir}/sail" "$@"
  return
fi

exec "${dir}/sail" "$@"
