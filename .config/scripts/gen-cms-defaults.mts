/**
 * Regenerate the CMS pages SQL seeder from `marketing_props.ts` (DB defaults).
 * Run: pnpm exec vite-node --config web/vitest.config.ts .config/scripts/gen-cms-defaults.mts
 *
 * Copy / demo data lives in shared CMS defaults + seeders — not in web page constants.
 */
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

import {
  HOME_PAGE_SEO,
  HOME_SECTION_DEFAULTS,
  INVESTOR_PAGE_SEO,
  INVESTOR_SECTION_DEFAULTS,
} from '../../shared_modules/nuc_admin/cms/defaults/marketing_props'

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..')

/** Keep in sync with `DEFAULT_HOME_SECTIONS` in `cms/default_pages.ts`. */
const HOME_META = [
  { id: 'home-hero', type: 'section.hero', order: 0 },
  { id: 'home-compiler', type: 'section.compiler_demo', order: 1 },
  { id: 'home-pillars', type: 'section.pillars', order: 2 },
  { id: 'home-stack', type: 'section.stack', order: 3 },
  { id: 'home-clone', type: 'section.clone', order: 4 },
  { id: 'home-close', type: 'section.close', order: 5 },
] as const

const INVESTOR_META = [
  { id: 'investor-intro', type: 'section.intro', order: 0 },
  { id: 'investor-thesis', type: 'section.thesis', order: 1 },
  { id: 'investor-savings', type: 'section.savings', order: 2 },
  { id: 'investor-wedge', type: 'section.wedge', order: 3 },
  { id: 'investor-surface', type: 'section.surface', order: 4 },
  { id: 'investor-ask', type: 'section.ask', order: 5 },
] as const

function sqlEscape(json: string): string {
  return json.replace(/'/g, "''")
}

function buildPageData(
  sections: readonly { id: string; type: string; order: number }[],
  defaults: Record<string, Record<string, unknown>>,
  seo: { title: string; description: string }
) {
  return {
    version: 1,
    sections: sections.map((s) => ({
      id: s.id,
      type: s.type,
      order: s.order,
      props: defaults[s.type] ?? {},
    })),
    seo: {
      title: seo.title,
      description: seo.description,
    },
  }
}

const homeData = buildPageData(
  HOME_META,
  HOME_SECTION_DEFAULTS as unknown as Record<string, Record<string, unknown>>,
  HOME_PAGE_SEO
)
const investorData = buildPageData(
  INVESTOR_META,
  INVESTOR_SECTION_DEFAULTS as unknown as Record<
    string,
    Record<string, unknown>
  >,
  INVESTOR_PAGE_SEO
)

const seederSql = `-- Published default layouts for marketing pages (home + investor).
-- Full section props (copy, demo data, layout). Regenerated by:
--   pnpm exec vite-node --config web/vitest.config.ts .config/scripts/gen-cms-defaults.mts
-- Source of truth: shared_modules/nuc_admin/cms/defaults/marketing_props.ts

insert into public.cms_documents (
  collection_slug,
  locale,
  title,
  slug,
  status,
  published_at,
  data
)
values
  (
    'pages',
    'en',
    'Home',
    'home',
    'published',
    now(),
    '${sqlEscape(JSON.stringify(homeData))}'::jsonb
  ),
  (
    'pages',
    'en',
    'Investor',
    'investor',
    'published',
    now(),
    '${sqlEscape(JSON.stringify(investorData))}'::jsonb
  )
on conflict (collection_slug, slug, locale) do update set
  title = excluded.title,
  status = excluded.status,
  published_at = coalesce(public.cms_documents.published_at, excluded.published_at),
  data = excluded.data,
  updated_at = now();
`

const seederPath = path.join(
  root,
  'shared_modules/nuc_admin/supabase/seeders/20261024120000_nuc_admin_cms_default_pages_seeder.sql'
)

fs.writeFileSync(seederPath, seederSql)
console.log('wrote', seederPath)
