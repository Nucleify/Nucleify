{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": "..",
    "paths": {
      "vue": ["node_modules/vue"],
      "vue-i18n": ["node_modules/vue-i18n"],
      "h3": ["node_modules/h3"],
      "nitropack/runtime": ["node_modules/nitropack/runtime"],
      "nuxt/app": ["node_modules/nuxt/dist/app"],
      "nuxt/*": ["node_modules/nuxt/*"],
      "#imports": [".nuxt/imports.d.ts"],
      "nucleify": ["nuxt/nucleify.ts"],
      "nuc_api": ["modules/nuc_api/supabase/api/server.ts"],
      "nuc_client": ["nuxt/nuc_client.ts"],
      "nuc_server": ["nuxt/server/nuc_server.ts"],
      "modules": ["modules"],
      "modules/*": ["modules/*"],
      "~/*": ["nuxt/*"]
    }
  },
  "include": [
    "../**/*.d.ts",
    "../**/*.ts",
    "../**/*.tsx",
    "../**/*.vue",
    "../**/*.js",
    "../**/*.jsx"
  ],
  "exclude": [
    "../node_modules",
    "../.nuxt",
    "../dist",
    "../cypress*",
    "../next",
    "../next/app",
    "../vendor",
    "../modules/**/*.tsx",
    "../modules/**/*.react.ts",
    "../modules/**/index.react.ts",
    "../modules/**/index.react.tsx",
    "../modules/**/supabase/functions/**",
    "../modules/**/supabase/calendly/**",
    "../modules/**/supabase/google_calendar/**",
    "../**/*.stories.ts",
    "../**/*.stories.tsx",
    "../**/*.spec.ts",
    "../**/*.spec.tsx",
    "../**/*.test.ts",
    "../**/*.test.tsx"
  ]
}
