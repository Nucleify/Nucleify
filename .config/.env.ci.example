CI=true

APP_NAME=Nucleify
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
API_URL=http://localhost/api

# You can choose 'next' too
APP_FRONTEND=nuxt

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_DATABASE=nucleify_test
DB_DATABASE=nucleify
DB_USERNAME=root
DB_PASSWORD=
DB_FOREIGN_KEYS=false
ADMIN_PASSWORD=example123
SUPER_ADMIN_PASSWORD=example123

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# nuxt.config.ts
SSR=true
PRERENDER_ROUTES=
PRERENDER_CRAWL_LINKS=
PRERENDER_IGNORE=
PRERENDER_LOCALES=
PAGE_BUILDER_PRERENDER_LOCALES=en,pl,vn
PAGE_BUILDER_PRERENDER_SLUGS=
DEV_TOOLS=

# Nucleify
NUC_SUBMODULES_BRANCH=main
NUC_SUBMODULES_CHECK=1
NUC_ALLOWED_ORIGINS=

# Netlify
NETLIFY=true
NETLIFY_ACCESS_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_BUILD_HOOK=
