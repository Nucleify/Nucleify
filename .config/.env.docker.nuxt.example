APP_NAME=Nucleify
APP_ENV=local
APP_DEBUG=true
NUXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EDGE_BASE=

# You can choose 'next' too
APP_FRONTEND=nuxt

# Platform: 'linux/arm64' for Apple Silicon (Mac M-series), 'linux/amd64' for Windows/Linux (Intel/AMD)
DOCKER_PLATFORM=linux/amd64

# Linux: `id -u` / `id -g` — zgodnie z kontem na hoście (pliki z kontenera na bind-mount). macOS: często 501:20.
DOCKER_UID=1000
DOCKER_GID=1000

# nuxt.config.ts
SSR=true
PRERENDER_ROUTES=/home,/dev,/login,/register,/admin,/thank-you,/offer,/docs,/404,/builder
PRERENDER_CRAWL_LINKS=true
PRERENDER_IGNORE=/settings
PRERENDER_LOCALES=en,pl,vn
DEV_TOOLS=
NITRO_PRESET=cloudflare

# Nucleify
NUC_SUBMODULES_BRANCH=main
NUC_SUBMODULES_CHECK=1
NUC_ALLOWED_ORIGINS=
NUC_ALLOWED_ORIGINS_PATTERNS=
NUC_CONVERT_DOCUMENTS_URL=https://convert-documents-nucleify.koyeb.app
