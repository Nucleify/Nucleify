APP_NAME=Nucleify
APP_ENV=local
APP_DEBUG=true
# Next dev URL (use the port Next prints, e.g. 3001 if 3000 is taken by Nuxt)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EDGE_BASE=

# You can choose 'nuxt' too
APP_FRONTEND=next

# nuxt.config.ts
SSR=true
PRERENDER_ROUTES=/home,/dev,/login,/register,/admin,/thank-you,/offer,/docs,/404,/builder
PRERENDER_CRAWL_LINKS=true
PRERENDER_IGNORE=/settings
PRERENDER_LOCALES=en,pl,vn
DEV_TOOLS=
NITRO_PRESET=cloudflare

# Nucleify
NUC_SUBMODULES_BRANCH=main
NUC_SUBMODULES_CHECK=1
NUC_ALLOWED_ORIGINS=
NUC_ALLOWED_ORIGINS_PATTERNS=
NUC_CONVERT_DOCUMENTS_URL=https://convert-documents-nucleify.koyeb.app

# Calendly
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_OAUTH_REDIRECT_URI=
CALENDLY_APP_REDIRECT_URL=
CALENDLY_WEBHOOK_URL=