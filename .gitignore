# Dependencies
**/node_modules

# Env
**/.env
**/.env.*
!**/.env.*example

# Nuxt / Nitro / Vite outputs
**/.output
**/.data
**/.nuxt
**/.nuxtrc
**/.nitro
**/.cache
**/dist
**/build
**/.wrangler
**/.vercel
**/.stylelintcache

# Public build artefacts
**/public/build
**/public/hot
**/public/storage
**/public/sitemap.xml
!docs/public/sitemap.xml
**/storage/*.key

# Coverage / logs
**/coverage
**/logs
**/*.log
**/*npm-debug.log
**/*yarn-error.log

# Python
**/__pycache__/
**/*.py[cod]

# Python HTTP probe artefacts
pentest/out/*.json
!pentest/out/.gitkeep
pentest/logs/**
!pentest/logs/.gitkeep

# IDE / OS
**/.DS_Store
**/.fleet
**/.idea
**/.vscode

# TypeScript
**/tsconfig*.tsbuildinfo

# Compiler IR dumps (--dump-ir)
**/*.ir.json

# Generated simple emit demos at monorepo root only (recreated by `make vue|react|nuxt|next|solid|svelte|astro`)
# Use anchored paths so compiler/templates/* and portable/fixtures/emit/* stay tracked.
/vue/
/react/
/nuxt/
/next/
/solid/
/svelte/
/astro/
/web_next/
/admin_next/
/web_solid/
/admin_solid/
/web_svelte/
/admin_svelte/
/web_astro/
/admin_astro/
.nucleify-nm-*/
.nucleify-convert-git-*/
.nucleify-fixture-ext-*/
/ext_web_next_*/
# AI workflow
.ai/specs/*
!.ai/docs/
!.ai/docs/**

# Cursor: ignore synced rules; track project skills
.cursor/*
!.cursor/skills/
!.cursor/skills/**

# Supabase
supabase/.temp
